#!/bin/zsh

# The file ~/.claude-sandbox-init is sourced (not executed) as part of the
# sandbox script, and can manipulate the sandbox configuration before entering.
#
# Environment:
# - `bwopt` — array of bwrap options
# - `sdrun` — array of systemd-run options
# - `cmd` — command to execute in the sandbox
# - `r`/`w`/`ln` — functions: read / read+write / link

##
## Examples:
##

## Add the *current* dir read/write, but only if it's located somewhere under `~/projects/`:
# ! [[ $PWD/ == ~/projects/* ]] || bwopt+=( --tmpfs ~/projects $(w $PWD) )

## Add your full project dir read-only:
# bwopt+=( $(r ~/projects) )

## Add your `~/.opam` read/write:
# bwopt+=( $(w ~/.opam) )

## YOLO: Write to my $HOME, I don't need sandboxing:
# bwopt+=( $(w ~) )

## Make the list of system packages readable — Debian:
# bwopt+=( $(r /var/lib/dpkg) )

## Make the list of system packages readable — Arch:
# bwopt+=( $(r /etc/pacman.{conf,d} /var/lib/pacman) )
