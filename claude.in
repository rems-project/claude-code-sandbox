#!/bin/zsh
##
# Sandbox wrapper, nominally meant to run LLM agents.
#
# Wraps the payload process in 2 layers:
# - separate cgroup/slice (systemd-run)
# - private user/process/cgroup/ipc/uts namespace (bwrap)
#
# If you run `claude --shell`, you get a shell.
#
set -e

CLAUDE_SBX_BINDIR=${CLAUDE_SBX_BINDIR:-DUMMY}
CLAUDE_SBX_HOME=${CLAUDE_SBX_HOME:-$HOME/.claude-home}
CLAUDE_SBX_TMP=${CLAUDE_SBX_TMP:-/tmp/claude-private-${UID}}
CLAUDE_SBX_PROJECT_DIR=

zparseopts -D -E -A ARGS - -shell

function r { for p in $@; do echo --ro-bind-try $p $p; done; }
function w { for p in $@; do echo --bind-try $p $p; done; }
function ln { echo --symlink $1 $2; }
function wdev { for p in $@; do echo --dev-bind-try $p $p; done; }

bwopt=(
  --unshare-user --unshare-pid --unshare-ipc --unshare-cgroup --unshare-uts
  --die-with-parent # --new-session
  --disable-userns --assert-userns-disabled

  --proc /proc --dev /dev --tmpfs /dev/shm --mqueue /dev/mqueue

  --dir /var/tmp --dir /run/lock
  $(w /var/empty)

  $(ln ../run /var/run) $(ln ../run/lock /var/lock)
  $(w /run/systemd/resolve)

  $(r /usr/lib /usr/lib64)
  $(ln usr/lib /lib) $(ln usr/lib64 /lib64)

  $(r /usr/{bin,libexec,share,include,sbin,src} /opt/claude)
  $(r usr/bin /bin)

  $(r /etc/{passwd,group,nsswitch.conf,resolv.conf,gai.conf,host.conf,ld.so*})
  $(r /etc/{localtime,os-release,machine-id})
  $(r /etc/{ca-certificates,pki,ssl})
  $(r /etc/alternatives)
  $(r /etc/pacman.conf /etc/pacman.d /var/lib/pacman)

  --bind $CLAUDE_SBX_TMP /tmp
  --dir $XDG_RUNTIME_DIR
  --bind $CLAUDE_SBX_HOME $HOME
)

[[ -n $CLAUDE_SBX_PROJECT_DIR ]] && bwopt+=( --tmpfs $CLAUDE_SBX_PROJECT_DIR )

unset DBUS_SESSION_BUS_ADDRESS DESKTOP_SESSION DISPLAY GDMSESSION GDM_LANG GNOME_SETUP_DISPLAY INVOCATION_ID LISTEN_PIDFDID MANAGERPID MANAGERPIDFDID MEMORY_PRESSURE_WATCH MEMORY_PRESSURE_WRITE PICTURES SSH_AUTH_SOCK SYSTEMD_EXEC_PID TMUX TMUX_PANE TMUX_SERVER_ARGS WAYLAND_DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_MENU_PREFIX XDG_SESSION_CLASS XDG_SESSION_DESKTOP XDG_SESSION_EXTRA_DEVICE_ACCESS XDG_SESSION_TYPE

export XDG_DATA_DIRS=/usr/share
path=(/bin /usr/bin /usr/local/bin)

# claude
export DISABLE_UPDATES=1
export DISABLE_INSTALLATION_CHECKS=1

sdrun=(--quiet --user --scope --slice=agent)
cmd=$CLAUDE_SBX_BINDIR/claude
[[ -n ${ARGS[--shell]+yes} ]] && cmd=($SHELL --login)

[[ -f ~/.claude-sandbox-init ]] && source ~/.claude-sandbox-init

mkdir -m 0750 -p $CLAUDE_SBX_TMP $CLAUDE_SBX_HOME

exec systemd-run $sdrun \
  -- bwrap --args 9 9< <(printf $'%s\0' $bwopt) \
  -- $cmd $@

# vim: fdm=marker :
